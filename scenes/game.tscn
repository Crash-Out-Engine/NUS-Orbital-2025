visible = false
layout_mode = 2
size_flags_vertical = 3
script = ExtResource("16_1kice")

[node name="SandTileMap" type="TileMapLayer" parent="."]
z_index = -100
tile_set = SubResource("TileSet_dinhu")
script = ExtResource("9_vtaks")
noise = SubResource("FastNoiseLite_vtaks")
curve = SubResource("Curve_kvpfn")
tileset_dimensions = Vector2i(4, 4)

[node name="ChunkDebug" type="Node2D" parent="SandTileMap"]
z_index = 100
script = ExtResource("10_vtaks")

[node name="OverlayTileMap" type="TileMapLayer" parent="."]
z_index = -100
tile_set = SubResource("TileSet_1kice")
script = ExtResource("9_vtaks")
noise = SubResource("FastNoiseLite_264po")
curve = SubResource("Curve_5newe")
tileset_dimensions = Vector2i(3, 4)
zeroth_tile = Vector2i(4, 0)

[node name="ChunkDebug" type="Node2D" parent="OverlayTileMap"]
z_index = 100
script = ExtResource("10_vtaks")

[node name="GameMusic" type="AudioStreamPlayer" parent="."]
stream = ExtResource("15_ir15t")
autoplay = true
bus = &"Music"

[connection signal="child_entered_tree" from="EntityContainer" to="." method="_on_entities_child_entered_tree"]
[connection signal="child_exiting_tree" from="EntityContainer" to="." method="_on_entities_child_exiting_tree"]
[connection signal="timeout" from="EnemySpawner/SpawnTimer" to="." method="_on_timer_timeout"]
[connection signal="timeout" from="EnemySpawner/SpawnTimer" to="EnemySpawner" method="_on_spawn_timer_timeout"]
[connection signal="pressed" from="UI/PauseMenu/PanelContainer/VBoxContainer/Resume" to="UI/PauseMenu" method="_on_resume_pressed"]
[connection signal="pressed" from="UI/PauseMenu/PanelContainer/VBoxContainer/Restart" to="UI/PauseMenu" method="_on_restart_pressed"]
[connection signal="pressed" from="UI/PauseMenu/PanelContainer/VBoxContainer/Quit" to="UI/PauseMenu" method="_on_quit_pressed"]
[connection signal="value_changed" from="UI/PauseMenu/PanelContainer/VBoxContainer/MasterVolumeContainer/MasterVolumeSlider" to="UI/PauseMenu" method="_on_master_volume_slider_value_changed"]
[connection signal="value_changed" from="UI/PauseMenu/PanelContainer/VBoxContainer/MusicVolumeContainer/MusicVolumeSlider" to="UI/PauseMenu" method="_on_music_volume_slider_value_changed"]
[connection signal="value_changed" from="UI/PauseMenu/PanelContainer/VBoxContainer/SFXVolumeContainer/SFXVolumeSlider" to="UI/PauseMenu" method="_on_sfx_volume_slider_value_changed"]
[connection signal="toggled" from="UI/DebugPanel/VBoxContainer/Button" to="UI/DebugPanel/VBoxContainer/Tree" method="_on_button_toggled"]
[connection signal="button_clicked" from="UI/DebugPanel/VBoxContainer/Tree" to="UI/DebugPanel" method="_on_tree_button_clicked"]
[connection signal="item_edited" from="UI/DebugPanel/VBoxContainer/Tree" to="UI/DebugPanel" method="_on_tree_item_edited"]
